<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>LeoAnalyzers.CodeFixes</RootNamespace>
        <AssemblyName>LeoAnalyzers.CodeFixes</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Same Roslyn baseline as the analyzer, so the fixes load in the same IDE versions. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LeoAnalyzers\LeoAnalyzers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LeoAnalyzers.CodeFixes.Tests" />
    </ItemGroup>

</Project>
